---
import HamburgerMenu from "./HamburgerMenu.tsx";
import { HEADER_NAV, type NavKey } from "../lib/navigation.js";

interface Props {
  currentPage: NavKey;
}
const { currentPage } = Astro.props;
---

<header class="eco-header">
  <div class="eco-container eco-header-inner">
    <a href="/" class="eco-lockup focus-industrial" aria-label="AI News Hub, home">
      <svg class="eco-mark" viewBox="0 0 24 24" aria-hidden="true">
        <rect x="2" y="8" width="2.4" height="8" fill="var(--ink-2)" />
        <rect x="6" y="5" width="2.4" height="14" fill="var(--ink-1)" />
        <rect x="10" y="2" width="2.6" height="20" fill="var(--signal)" />
        <rect x="14.6" y="5" width="2.4" height="14" fill="var(--ink-1)" />
        <circle cx="20.5" cy="12" r="2.2" fill="var(--signal)" />
      </svg>
      <span class="eco-wordmark">AI News</span>
    </a>

    <nav class="eco-nav hidden lg:flex" aria-label="Primary navigation">
      {HEADER_NAV.map((item) => (
        <a
          href={item.href}
          class="eco-nav-link whitespace-nowrap"
          aria-current={currentPage === item.key ? "page" : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <span class="hidden text-xs text-text-2 xl:block">Free. No account.</span>
      <button id="theme-toggle" class="eco-icon-btn eco-theme-toggle" type="button" aria-label="Toggle light and dark theme" title="Toggle light and dark theme">
        <svg class="eco-icon-sun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/>
        </svg>
        <svg class="eco-icon-moon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
        </svg>
      </button>
      <div class="flex lg:hidden">
        <HamburgerMenu client:media="(max-width: 1023px)" currentPage={currentPage} />
      </div>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    var button = document.getElementById("theme-toggle");
    if (!button || button.dataset.bound) return;
    button.dataset.bound = "1";
    button.addEventListener("click", function () {
      if (window.__ecoTheme) window.__ecoTheme.toggle();
    });
  })();
</script>
