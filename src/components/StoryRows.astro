---
import { URL } from "node:url";
import { companyLogoAlt, resolveCompanyLogo } from "../lib/companyCatalog.js";
import { articlePath } from "../lib/articleRoutes.js";
import { groupFeedRows, rowExcerpt, utcClockTime } from "../lib/feedRows.js";
import { itemTypeLabel } from "../lib/itemTypes.js";
import { classifyMajorUpdate } from "../lib/majorUpdates.js";
import { unavailableArticleSource } from "../lib/articleSourceAvailability.mjs";
import { buildGroupLabel, recordDisplayTitle, recordKind, recordKindLabel, releaseTag, titleNeedsProject } from "../lib/releaseKind.js";
import PublisherText from "./PublisherText.astro";
import type { Article } from "../types/article.js";

interface StoryRow {
  article: Article;
  reason?: string;
}

interface Props {
  rows: StoryRow[];
  emptyMessage?: string;
  /** "clock" on a single-day page, where repeating the date on every row says nothing. */
  time?: "date" | "clock";
  /** Row titles sit one level under the heading that introduces the list. */
  headingLevel?: 2 | 3;
  /** On a single publisher's page the name on every row is noise. */
  hidePublisher?: boolean;
  /** Set when a ruled heading sits directly above, so the list draws no second rule. */
  flush?: boolean;
}

const { rows, emptyMessage = "No stories are available yet.", time = "date", headingLevel = 2, hidePublisher = false, flush = false } = Astro.props as Props;
const Heading = `h${headingLevel}` as "h2" | "h3";
const reasons = new Map(rows.map((row) => [row.article.id, row.reason]));
const feedRows = groupFeedRows(rows.map((row) => row.article));
const dateLabel = (iso: string) => new Intl.DateTimeFormat("en-US", {
  month: "short", day: "numeric", year: "numeric", timeZone: "UTC",
}).format(new Date(iso));
const timeLabel = (iso: string) => (time === "clock" ? utcClockTime(iso) : dateLabel(iso));
const sourceDomain = (url: string) => {
  try {
    const parsed = new URL(url);
    return parsed.protocol === "https:" || parsed.protocol === "http:" ? parsed.hostname.replace(/^www\./, "") : "";
  } catch {
    return "";
  }
};
---

{feedRows.length ? (
  <ol class="story-rows border-t border-white/25" data-gutter={time} data-flush={flush ? "true" : undefined}>
    {feedRows.map((row, index) => {
      if (row.type === "builds") {
        const newest = row.articles[0];
        const tags = row.articles.slice(0, 2).map((article) => releaseTag(article.title));
        return (
          <li class="feed-builds">
            <span class="feed-builds-time" aria-hidden="true">{timeLabel(newest.published_at)}</span>
            <details>
              <summary class="feed-builds-toggle focus-industrial">
                <span class="feed-logo">
                  <img src={resolveCompanyLogo(row.company)} alt="" width="16" height="16" loading="lazy" decoding="async" />
                </span>
                <span class="feed-builds-summary">
                  <span><span class="feed-publisher">{row.company}</span> <span class="tabular-nums">{buildGroupLabel(row.articles)}</span></span>
                  <span class="feed-builds-range"><PublisherText text={tags.join(", ")} />{row.articles.length > tags.length && ` and ${row.articles.length - tags.length} more`}</span>
                </span>
                <svg class="feed-builds-chevron" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" aria-hidden="true">
                  <path d="m2.5 4.5 3.5 3.5 3.5-3.5" />
                </svg>
              </summary>
              <ul class="feed-builds-list">
                {row.articles.map((article) => (
                  <li>
                    <time class="feed-time" datetime={article.published_at}>{utcClockTime(article.published_at)}</time>
                    <a href={articlePath(article.id)} class="feed-version focus-industrial"><PublisherText text={article.title} /></a>
                  </li>
                ))}
              </ul>
            </details>
          </li>
        );
      }
      const { article } = row;
      const kind = recordKind(article);
      // A page that states its own selection reason prints it as plain text on every row.
      // Elsewhere a rule match is the one red tag in the row.
      const statedReason = reasons.get(article.id);
      const majorTag = !statedReason && classifyMajorUpdate(article) ? "Major update" : undefined;
      const typeLabel = kind === "build" ? recordKindLabel(kind, article) : itemTypeLabel(article.item_type) ?? recordKindLabel(kind, article);
      const displayTitle = recordDisplayTitle(article);
      const excerpt = rowExcerpt(article);
      const sourceUnavailable = Boolean(unavailableArticleSource(article.url));
      const domain = sourceUnavailable ? "" : sourceDomain(article.url);
      return (
        <li class="feed-row" data-kind={kind}>
          <span class="feed-logo">
            <img src={resolveCompanyLogo(article.company)} alt={companyLogoAlt(article.company)} width="22" height="22" loading={index < 6 ? "eager" : "lazy"} decoding="async" />
          </span>
          <div class="feed-body min-w-0">
            <p class="feed-meta">
              <time class="feed-time" datetime={article.published_at}>{timeLabel(article.published_at)}</time>
              {!hidePublisher && <span class="feed-publisher">{article.company}</span>}
              {majorTag && <span class="feed-major">{majorTag}</span>}
              {statedReason && <span>{statedReason}</span>}
              {typeLabel && <span>{typeLabel}</span>}
            </p>
            <Heading class="feed-title">
              <a href={articlePath(article.id)} class="focus-industrial">
                {kind === "story" ? (
                  <PublisherText text={article.title} />
                ) : (
                  <Fragment>
                    {titleNeedsProject(article) && <Fragment><span class="feed-title-project">{article.company}</span>{" "}</Fragment>}
                    <span class="feed-version"><PublisherText text={article.title} /></span>
                  </Fragment>
                )}
              </a>
            </Heading>
            {excerpt && (
              <p class="feed-excerpt line-clamp-2"><PublisherText text={excerpt} /></p>
            )}
            {domain && (
              <a href={article.url} target="_blank" rel="noopener noreferrer" class="feed-source focus-industrial" aria-label={`Original source on ${domain} for “${displayTitle}”`}>
                {domain}
                <svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" aria-hidden="true">
                  <path d="M4.5 2.5h5v5" /><path d="M9.5 2.5 2.5 9.5" />
                </svg>
              </a>
            )}
            {sourceUnavailable && <span class="feed-source feed-source-missing">Source unavailable</span>}
          </div>
        </li>
      );
    })}
  </ol>
) : (
  <div class="industrial-border p-8">
    <p class="text-sm text-text-2">{emptyMessage}</p>
  </div>
)}
