---
import Layout from "../layouts/Layout.astro";

const siteUrl = "https://ai-news.helloworldfirm.com";
const canonicalUrl = `${siteUrl}/contact/`;
const title = "Contact AI News Hub and Hello.World Consulting";
const description =
  "Contact AI News Hub about source coverage, feed issues, AI research updates, provider additions and Hello.World Consulting maintenance.";
const structuredData = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: title,
  url: canonicalUrl,
  description,
  author: {
    "@type": "Person",
    name: "Jonathan R Reed",
    url: "https://jonathanrreed.com",
  },
  datePublished: "2026-04-21",
  dateModified: "2026-04-21",
  isPartOf: {
    "@type": "WebSite",
    name: "AI News Hub",
    url: siteUrl,
  },
};
---

<Layout
  title={title}
  description={description}
  canonical={canonicalUrl}
  robots="index, follow, max-image-preview:large"
  structuredData={structuredData}
>
  <main id="main-content" class="industrial-shell flex-1">
    <section class="industrial-container py-24 md:py-36">
      <div class="max-w-5xl reveal-stagger">
        <h1 class="macro-heading max-w-5xl">Contact AI News Hub</h1>
        <div class="mt-8 max-w-4xl space-y-5 text-lg leading-relaxed text-text-2">
          <p>
            Missing feeds, broken links, bad attribution, accessibility problems, or a provider
            worth adding: send it here.
          </p>
          <p>
            A provider suggestion is easiest to act on with the organization name, the official
            RSS or Atom feed URL, and the public blog or research page. Inclusion is not for sale;
            it depends on whether the source publishes stable updates that fit the feed.
          </p>
          <p>
            Bug reports are most useful with the page URL, browser, device, and the action that
            failed. For article data, include the company name and the original publisher URL.
          </p>
        </div>
        <div class="mt-10 flex flex-wrap gap-4">
          <a class="signal-button" href="https://helloworldfirm.com/contact/">
            Contact Hello.World Consulting
          </a>
          <a class="signal-button" href="/">
            Back to the feed
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>
