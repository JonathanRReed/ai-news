---
import Layout from "../../layouts/Layout.astro";
import DigestView from "../../components/DigestView.astro";
import { digestWeeks } from "../../lib/digest.js";
import { resolveCompanyLogo } from "../../lib/companyCatalog.js";

const weeks = digestWeeks();
const latest = weeks[0];
const siteUrl = "https://ai-news.helloworldfirm.com";
const canonicalUrl = `${siteUrl}/digest/`;
const title = "This Week in AI | Weekly Digest | AI News Hub";
const description = latest
  ? `The latest AI news this week from ${latest.labs} official sources, with original links, publication dates, publisher names, and past weekly pages.`
  : "AI news organized by week from official lab and provider sources, with original links, publication dates, and publisher names.";
const structuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: title,
  description,
  url: canonicalUrl,
  isPartOf: { "@type": "WebSite", name: "AI News Hub", url: siteUrl },
};
const leadDigestLogo = latest?.topStories[0] ? resolveCompanyLogo(latest.topStories[0].company) : "";
---

<Layout title={title} description={description} canonical={canonicalUrl} currentPage="digest" structuredData={structuredData} preloadImages={leadDigestLogo ? [leadDigestLogo] : []}>
  <main id="main-content" class="industrial-shell flex-1">
    {latest ? (
      <DigestView digest={latest} allWeeks={weeks} />
    ) : (
      <section class="industrial-container py-24">
        <h1 class="macro-heading">No digest yet</h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-text-2">No stories have come in for this week yet. Check back after the next feed refresh.</p>
        <a href="/" class="signal-button mt-8">Back to the feed</a>
      </section>
    )}
  </main>
</Layout>
