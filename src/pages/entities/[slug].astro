---
import EntityNewsPage from "../../components/EntityNewsPage.astro";
import { allArticles } from "../../lib/feeds.js";
import { entityForArticle, entitySources, intelligenceEntities } from "../../lib/intelligenceCatalog.js";
export function getStaticPaths() {
  const articles = allArticles();
  return intelligenceEntities.map((entity) => ({
    params: { slug: entity.slug },
    props: {
      entity,
      sources: entitySources(entity.slug),
      articles: articles.filter((article) => entityForArticle(article)?.slug === entity.slug),
    },
  }));
}

---
<EntityNewsPage {...Astro.props} />
