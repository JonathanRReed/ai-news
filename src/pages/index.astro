---
import Layout from "../layouts/Layout.astro";
import { AUTHOR_REF } from "../lib/author.js";
import ArticlesIslandWrapper from "../components/ArticlesIslandWrapper.tsx";
import SourceHealthOverview from "../components/SourceHealthOverview.tsx";
import PublisherText from "../components/PublisherText.astro";
import providerArticles from "../../public/data/provider-articles.json";
import { utcDayKey, UNDATED_DAY } from "../lib/feedRows.js";
import { admittedArticles } from "../lib/articleAdmission.js";
import { articleExcerpt } from "../lib/articleExcerpt.js";
import { articlePath } from "../lib/articleRoutes.js";
import { resolveCompanyLogo } from "../lib/companyCatalog.js";
import { activeEntities, intelligenceSources } from "../lib/intelligenceCatalog.js";
import { majorUpdates, OTHER_MAKER_REASON } from "../lib/majorUpdates.js";
import type { Article } from "../types/article.js";

const siteUrl = "https://ai-news.helloworldfirm.com";
const canonicalUrl = `${siteUrl}/`;
const title = "AI News | AI Updates From Original Sources";
const description =
  "Tracked AI news and releases from labs, model providers, research teams, and agent tools, with original publisher attribution.";
const keywords =
  "AI news, artificial intelligence news, AI research updates, OpenAI news, Anthropic updates, Google DeepMind announcements, Mistral AI, Hugging Face, Meta AI, xAI, DeepSeek, IBM Research, Amazon AI, NVIDIA AI, Alibaba Qwen";
const socialImage = `${siteUrl}/ai-news-favicon-512x512.png`;
const articles = admittedArticles(providerArticles as Article[]);
const providerRows = articles;
const activeSourceCount = intelligenceSources.filter((source) => source.active).length;
const trackedEntityCount = activeEntities.length;
const allMajorUpdates = majorUpdates(articles);
const majorUpdateCount = allMajorUpdates.length;
// The rail lists launches from the model's own maker. Notices from other providers about the
// same model stay on the full Major updates page, where each row states its reason.
const latestMajorUpdates = allMajorUpdates
  .filter((update) => update.reason !== OTHER_MAKER_REASON)
  .sort((a, b) => (
    new Date(b.article.published_at).getTime() - new Date(a.article.published_at).getTime()
    || b.article.id.localeCompare(a.article.id)
  ))
  .slice(0, 4);
const shortDate = (iso: string) => new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", timeZone: "UTC" }).format(new Date(iso));
// Day headers in the feed link to the permanent daily page only when one was built.
const archiveDays = [...new Set(articles.map((article) => utcDayKey(article.published_at)))]
  .filter((day) => day !== UNDATED_DAY)
  .sort((a, b) => b.localeCompare(a))
  .slice(0, 400);
const nowMs = Date.now();
const latestCacheDate = providerRows
  .map((article) => new Date(article.published_at).getTime())
  .filter((time) => Number.isFinite(time))
  .sort((a, b) => b - a)[0];
const latestCacheIso = new Date(nowMs).toISOString();
// Absolute date, not a relative label: this is static HTML that only rebuilds when the
// cache changes, so a relative value would go stale (and lie) on quiet days.
const newestLabel = latestCacheDate
  ? new Intl.DateTimeFormat("en-US", { timeZone: "UTC", month: "short", day: "numeric", year: "numeric" }).format(new Date(latestCacheDate))
  : "No date";
// Seed the first 20 (content stripped to keep the HTML lean) so the island renders
// server-side for crawlers and first paint, then refetches full data on the client.
const initialArticles: Article[] = articles
  .slice()
  .sort((a, b) => (
    new Date(b.published_at).getTime() - new Date(a.published_at).getTime()
    || b.id.localeCompare(a.id)
  ))
  .slice(0, 20)
  .map((a) => ({
    id: a.id,
    company: a.company,
    title: a.title,
    url: a.url,
    published_at: a.published_at,
    item_type: a.item_type,
    source_type: a.source_type,
    source_url: a.source_url,
    source_key: a.source_key,
    summary: articleExcerpt(a),
  }));
const leadArticleLogo = initialArticles[0] ? resolveCompanyLogo(initialArticles[0].company) : "";
const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "AI News Hub",
  url: siteUrl,
  description,
  creator: AUTHOR_REF,
  publisher: {
    "@type": "Organization",
    name: "Hello.World Consulting",
    url: "https://helloworldfirm.com",
    logo: {
      "@type": "ImageObject",
      url: socialImage,
    },
  },
};

const collectionStructuredData = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: title,
  description,
  url: siteUrl,
  author: AUTHOR_REF,
  datePublished: "2026-04-21",
  dateModified: latestCacheIso.slice(0, 10),
  isPartOf: {
    "@type": "WebSite",
    name: "AI News Hub",
    url: siteUrl,
  },
};
---

<Layout
  title={title}
  description={description}
  canonical={canonicalUrl}
  keywords={keywords}
  currentPage="home"
  bodyClass="bg-bg-0 text-text-1 font-sans"
  structuredData={[structuredData, collectionStructuredData]}
  preloadImages={leadArticleLogo && !leadArticleLogo.startsWith("data:") ? [leadArticleLogo] : []}
>
  <main id="main-content" class="industrial-shell">
    <section class="industrial-container pb-6 pt-8 md:pb-8 md:pt-10">
      <h1 class="macro-heading masthead-heading">See what changed in AI today.</h1>
      <p class="mt-3 max-w-4xl text-base leading-relaxed text-text-2 text-pretty md:text-lg">
        Announcements from AI labs, model makers, research teams, and agent tools, in the order they were published. No account required.
      </p>
      <p class="mt-4 flex flex-wrap gap-x-5 gap-y-1 text-sm text-text-2">
        <span><span class="font-mono tabular-nums text-white">{trackedEntityCount}</span> companies and projects</span>
        <SourceHealthOverview client:load registryActive={activeSourceCount} />
        <span>Stories through <span class="font-mono text-white">{newestLabel}</span></span>
      </p>
    </section>

    <div class="industrial-container home-layout pb-12 md:pb-16">
      {latestMajorUpdates.length > 0 && (
        <aside class="home-major" aria-labelledby="rail-major-heading">
          <div class="rail-block">
            <div class="rail-head">
              <h2 id="rail-major-heading" class="rail-title">Major updates</h2>
              <a href="/major-updates/" class="rail-link focus-industrial">All {majorUpdateCount}</a>
            </div>
            <ol class="rail-major-list">
              {latestMajorUpdates.map(({ article }, index) => (
                <li class={index >= 3 ? "max-lg:hidden" : undefined}>
                  <p class="rail-major-meta">
                    <time datetime={article.published_at}>{shortDate(article.published_at)}</time>
                    <span>{article.company}</span>
                  </p>
                  <a href={articlePath(article.id)} class="focus-industrial"><PublisherText text={article.title} /></a>
                </li>
              ))}
            </ol>
            <p class="rail-note">
              Launches announced by their own makers, picked by a <a href="/major-updates/" class="focus-industrial">published rule</a>. Feeds: <a href="/feed/major.xml" class="focus-industrial">major updates</a>, <a href="/feed.xml" class="focus-industrial">everything</a>, <a href="/feeds/" class="focus-industrial">by publisher or topic</a>.
            </p>
          </div>
        </aside>
      )}

      <section id="articles" class="home-feed" aria-label="Latest updates">
        <ArticlesIslandWrapper client:load initialArticles={initialArticles} now={nowMs} archiveDays={archiveDays} />
      </section>
    </div>
  </main>
</Layout>
