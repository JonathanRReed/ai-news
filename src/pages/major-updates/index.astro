---
import Layout from "../../layouts/Layout.astro";
import StoryRows from "../../components/StoryRows.astro";
import { allArticles, SITE_URL } from "../../lib/feeds.js";
import { majorUpdates } from "../../lib/majorUpdates.js";

const updates = majorUpdates(allArticles());
const description = "Named model releases and major agent-tool versions from official sources. Every included headline has to match the published rule.";
---

<Layout title="Major AI Updates | AI News Hub" description={description} canonical={`${SITE_URL}/major-updates/`} currentPage="major">
  <main id="main-content" class="industrial-shell flex-1">
    <section class="industrial-container py-10 md:py-14">
      <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_24rem] lg:items-end">
        <div class="reveal-stagger">
          <h1 class="macro-heading">Major AI updates.</h1>
          <p class="mt-6 max-w-3xl text-lg leading-relaxed text-text-2">{description}</p>
        </div>
        <aside class="industrial-border p-5">
          <p class="micro-label text-text-2">What counts as major</p>
          <p class="mt-3 leading-relaxed text-white">The publisher’s headline must use release language and name a model version or a major agent-tool version. No provider ranking or hidden editorial score is used.</p>
          <p class="micro-label mt-4 text-brand-hover">{updates.length} matching updates</p>
        </aside>
      </div>
    </section>
    <section class="industrial-container pb-16 md:pb-24">
      <StoryRows rows={updates.slice(0, 120)} emptyMessage="No headlines currently match the Major Updates rule." />
    </section>
  </main>
</Layout>
