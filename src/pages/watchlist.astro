---
import Layout from "../layouts/Layout.astro";
import WatchlistIsland from "../components/WatchlistIsland.tsx";
import { allArticles, SITE_URL } from "../lib/feeds.js";
import { intelligenceEntities } from "../lib/intelligenceCatalog.js";

const description = "A private, browser-local watchlist for AI labs, providers, and agent harnesses. No login, profile, or paid plan required.";
---

<Layout title="My AI Watchlist | AI News Hub" description={description} canonical={`${SITE_URL}/watchlist/`}>
  <main id="main-content" class="industrial-shell flex-1">
    <section class="industrial-container py-10 md:py-14">
      <div class="max-w-5xl reveal-stagger">
        <p class="micro-label mb-5 text-brand-hover">[ Local watchlist ]</p>
        <h1 class="macro-heading">Your corner of the index.</h1>
        <p class="mt-6 max-w-3xl text-lg leading-relaxed text-text-2">Saved only in this browser. Nothing is uploaded, and there is no account to create.</p>
      </div>
    </section>
    <section class="industrial-container pb-16 md:pb-24">
      <WatchlistIsland client:load entities={intelligenceEntities} articles={allArticles()} />
    </section>
  </main>
</Layout>
